# Plutonium Browser - Maximum Performance Linux Build Configuration
# 
# This configuration targets maximum runtime performance.
# Build times will be longer, but the resulting browser will be faster.
#
# CPU COMPATIBILITY:
#   - Default config: Works on all x86-64 CPUs (2011+)
#   - With use_avx2=true: Requires Haswell (2013+) or AMD Zen (2017+)

# =============================================================================
# LINUX PLATFORM SETTINGS
# =============================================================================
is_clang=true
is_debug=false
use_sysroot=true

# =============================================================================
# MEDIA & CODECS
# =============================================================================
# Enable Chrome-branded FFmpeg with all codecs (H.264, AAC, etc.)
ffmpeg_branding="Chrome"
proprietary_codecs=true

# Hardware video acceleration (VA-API) - essential for video performance
use_vaapi=true

# =============================================================================
# LINUX-SPECIFIC FEATURES
# =============================================================================
# PipeWire for WebRTC screen sharing (lower latency than PulseAudio)
rtc_use_pipewire=true

# Disable Kerberos (not typically needed for desktop)
use_kerberos=false

# Use bundled libffi
use_system_libffi=false

# =============================================================================
# LINKER SETTINGS & OPTIMIZATIONS
# =============================================================================
# Don't fail on linker warnings (some warnings are expected)
fatal_linker_warnings=false

# Use LLVM's lld linker (faster linking, better LTO support)
use_lld=true

# Identical Code Folding - merges identical functions (smaller binary)
use_icf=true

# =============================================================================
# PERFORMANCE OPTIMIZATIONS
# =============================================================================
# Text section splitting for better instruction cache locality
use_text_section_splitting=true

# Control Flow Integrity - security with a runtime cost
# Disabled for maximum performance (trade-off: reduced exploit mitigation)
is_cfi=false

# Disable precompiled headers - slower build but potentially better codegen
enable_precompiled_headers=false

# =============================================================================
# CPU TARGETING - SIMD OPTIMIZATIONS
# =============================================================================
# These flags enable SIMD instructions for better performance.
# The more advanced flags require newer CPUs.

# SSE3/SSSE3/SSE4.1/SSE4.2 - Available on all modern x86-64 CPUs (2011+)
use_sse3=true
use_sse41=true
use_sse42=true

# AVX - Available on Sandy Bridge (2011+) and newer
# Enables 256-bit floating-point SIMD operations
use_avx=true

# AVX2 - Available on Haswell (2013+), AMD Excavator (2015+), AMD Zen (2017+)
# Enables 256-bit integer SIMD operations - significant performance boost
# Enabled for Ryzen 7 7800X3D (Zen 4 fully supports AVX2)
use_avx2=true

# =============================================================================
# THORIUM-STYLE COMPILER OPTIMIZATIONS
# =============================================================================
# These are enabled via patches (see patches/helium/linux/)
# - compiler-optimizations.patch: -O3, LLVM loop opts, import_instr_limit=100
# - avx2-optimizations.patch: AVX2/FMA targeting when use_avx2=true
# - scrolling-performance.patch: GPU rasterization, zero-copy, raster threads
# - disable-status-bubble.patch: Removes URL preview bubble
# - chrome-default-colors.patch: Chrome's original gray color scheme
