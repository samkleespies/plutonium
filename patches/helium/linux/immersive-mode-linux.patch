+int ImmersiveModeControllerLinux::GetTopContainerVerticalOffset(
+    const gfx::Size& top_container_size) const {
+  // We use transforms now, so always return 0 for layout purposes
+  return 0;
+}
+
+std::unique_ptr<ImmersiveRevealedLock>
+ImmersiveModeControllerLinux::GetRevealedLock(AnimateReveal animate_reveal) {
+  ++reveal_lock_count_;
+  LOG(WARNING) << "GetRevealedLock: lock_count now " << reveal_lock_count_;
+  if (animation_state_ != AnimationState::kRevealed) {
+    StartReveal(animate_reveal == AnimateReveal::ANIMATE_REVEAL_YES);
+  }
+  return std::make_unique<RevealedLock>(weak_ptr_factory_.GetWeakPtr());
+}
