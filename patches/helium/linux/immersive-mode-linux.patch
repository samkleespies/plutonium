+namespace {
+
+gfx::Rect GetBoundsInBrowserView(const views::View* view,
+                                 const views::View* browser_view) {
+  if (!view || !browser_view) {
+    return gfx::Rect();
+  }
+  return views::View::ConvertRectToTarget(view, browser_view,
+                                          view->GetLocalBounds());
+}
+
+void LogViewSummary(const char* label, BrowserView* browser_view) {
+  static int log_count = 0;
+  if (!browser_view || log_count++ > 3) {
+    return;
+  }
+
+  auto log_view = [&](const char* name, const views::View* view) {
+    if (!view) {
+      LOG(WARNING) << "Immersive layout(" << label << "): " << name << " null";
+      return;
+    }
+    const gfx::Rect bounds = GetBoundsInBrowserView(view, browser_view);
+    std::string_view parent_name =
+        view->parent() ? view->parent()->GetClassName() : "null";
+    const bool drawn = view->IsDrawn();
+    const bool has_layer = view->layer() != nullptr;
+    const float opacity = has_layer ? view->layer()->opacity() : -1.0f;
+    LOG(WARNING) << "Immersive layout(" << label << "): " << name
+                 << " class=" << view->GetClassName()
+                 << " visible=" << view->GetVisible()
+                 << " drawn=" << drawn
+                 << " layer=" << has_layer
+                 << " opacity=" << opacity
+                 << " parent=" << parent_name
+                 << " bounds=" << bounds.ToString()
+                 << " pref=" << view->GetPreferredSize().ToString();
+  };
+
+  auto log_children = [&](const char* group, const views::View* parent,
+                          int max_children, int max_grandchildren) {
+    if (!parent) {
+      return;
+    }
+    int index = 0;
+    for (const auto& child : parent->children()) {
+      if (index >= max_children) {
+        LOG(WARNING) << "Immersive layout(" << label << "): " << group
+                     << " child[...] truncated";
+        break;
+      }
+      const views::View* child_view = child.get();
+      if (!child_view) {
+        ++index;
+        continue;
+      }
+      const gfx::Rect bounds = GetBoundsInBrowserView(child_view, browser_view);
+      const bool drawn = child_view->IsDrawn();
+      const bool has_layer = child_view->layer() != nullptr;
+      const float opacity = has_layer ? child_view->layer()->opacity() : -1.0f;
+      LOG(WARNING) << "Immersive layout(" << label << "): " << group
+                   << " child[" << index << "] class="
+                   << child_view->GetClassName()
+                   << " visible=" << child_view->GetVisible()
+                   << " drawn=" << drawn
+                   << " layer=" << has_layer
+                   << " opacity=" << opacity
+                   << " bounds=" << bounds.ToString()
+                   << " pref=" << child_view->GetPreferredSize().ToString();
+
+      if (max_grandchildren > 0) {
+        int sub_index = 0;
+        for (const auto& sub_child : child_view->children()) {
+          if (sub_index >= max_grandchildren) {
+            LOG(WARNING) << "Immersive layout(" << label << "): " << group
+                         << " child[" << index << "] sub[...] truncated";
+            break;
+          }
+          const views::View* sub_view = sub_child.get();
+          if (!sub_view) {
+            ++sub_index;
+            continue;
+          }
+          const gfx::Rect sub_bounds =
+              GetBoundsInBrowserView(sub_view, browser_view);
+          const bool sub_drawn = sub_view->IsDrawn();
+          const bool sub_has_layer = sub_view->layer() != nullptr;
+          const float sub_opacity =
+              sub_has_layer ? sub_view->layer()->opacity() : -1.0f;
+          LOG(WARNING) << "Immersive layout(" << label << "): " << group
+                       << " child[" << index << "] sub[" << sub_index
+                       << "] class=" << sub_view->GetClassName()
+                       << " visible=" << sub_view->GetVisible()
+                       << " drawn=" << sub_drawn
+                       << " layer=" << sub_has_layer
+                       << " opacity=" << sub_opacity
+                       << " bounds=" << sub_bounds.ToString()
+                       << " pref=" << sub_view->GetPreferredSize().ToString();
+          ++sub_index;
+        }
+      }
+      ++index;
+    }
+  };
+
+  log_view("browser_view", browser_view);
+  log_view("main_container", browser_view->main_container());
+  log_view("top_container", browser_view->top_container());
+  log_view("contents_container", browser_view->contents_container());
+  log_view("tab_strip", browser_view->tab_strip_view());
+
+  log_children("browser_view", browser_view, 10, 0);
+
+  if (auto* tab_strip_view = browser_view->tab_strip_view()) {
+    log_children("tab_strip", tab_strip_view, 10, 12);
+    for (const auto& child : tab_strip_view->children()) {
+      const views::View* child_view = child.get();
+      if (!child_view) {
+        continue;
+      }
+      if (std::string_view(child_view->GetClassName()) != "TabStrip") {
+        continue;
+      }
+      for (const auto& sub_child : child_view->children()) {
+        const views::View* sub_view = sub_child.get();
+        if (!sub_view) {
+          continue;
+        }
+        if (std::string_view(sub_view->GetClassName()) == "TabContainerImpl") {
+          log_children("tab_container", sub_view, 30, 0);
+          break;
+        }
+      }
+    }
+  }
+
+  if (auto* top_container = browser_view->top_container()) {
+    int index = 0;
+    for (const auto& child : top_container->children()) {
+      views::View* child_view = child.get();
+      if (!child_view) {
+        continue;
+      }
+      const gfx::Rect bounds = GetBoundsInBrowserView(child_view, browser_view);
+      LOG(WARNING) << "Immersive layout(" << label << "): top_container child["
+                   << index++ << "] class=" << child_view->GetClassName()
+                   << " visible=" << child_view->GetVisible()
+                   << " bounds=" << bounds.ToString()
+                   << " pref=" << child_view->GetPreferredSize().ToString();
+    }
+  }
+
+  if (auto* toolbar = browser_view->toolbar()) {
+    int index = 0;
+    for (const auto& child : toolbar->children()) {
+      views::View* child_view = child.get();
+      if (!child_view) {
+        continue;
+      }
+      const gfx::Rect bounds = GetBoundsInBrowserView(child_view, browser_view);
+      LOG(WARNING) << "Immersive layout(" << label << "): toolbar child["
+                   << index++ << "] class=" << child_view->GetClassName()
+                   << " visible=" << child_view->GetVisible()
+                   << " bounds=" << bounds.ToString()
+                   << " pref=" << child_view->GetPreferredSize().ToString();
+      int sub_index = 0;
+      for (const auto& sub_child : child_view->children()) {
+        views::View* sub_view = sub_child.get();
+        if (!sub_view) {
+          continue;
+        }
+        const gfx::Rect sub_bounds =
+            GetBoundsInBrowserView(sub_view, browser_view);
+        LOG(WARNING)
+            << "Immersive layout(" << label << "): toolbar child["
+            << index - 1 << "] sub[" << sub_index++ << "] class="
+            << sub_view->GetClassName()
+            << " visible=" << sub_view->GetVisible()
+            << " bounds=" << sub_bounds.ToString()
+            << " pref=" << sub_view->GetPreferredSize().ToString();
+      }
+    }
+  }
+}
