# Plutonium: Disable URL status bubble
#
# This patch completely disables the URL status bubble that appears when
# hovering over links. This provides a cleaner UI and slightly better
# performance by avoiding unnecessary rendering.
#
# The status bubble is disabled by returning early in SetURL().

--- a/chrome/browser/ui/views/status_bubble_views.cc
+++ b/chrome/browser/ui/views/status_bubble_views.cc
@@ -821,6 +821,9 @@
 void StatusBubbleViews::SetURL(const GURL& url) {
+  // Plutonium: Disable status bubble completely
+  // This provides a cleaner UI and better performance
+  return;
   url_ = url;
   if (size_.IsEmpty()) {
     return;  // We have no bounds, don't attempt to show the popup.
