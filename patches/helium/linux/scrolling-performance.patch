# Plutonium: Scrolling performance optimizations
#
# This patch enables several optimizations for smoother scrolling:
# - GPU rasterization enabled by default
# - Zero-copy rasterization when available
# - Increased raster thread count
# - Optimized tile sizes
#
# These settings match what Chrome Dev uses for maximum smoothness.

--- a/content/browser/gpu/gpu_process_host.cc
+++ b/content/browser/gpu/gpu_process_host.cc
@@ -XXX,6 +XXX,12 @@ void GpuProcessHost::AppendExtraCommandLineSwitches(
   // Plutonium: Enable GPU rasterization by default for smoother scrolling
   if (!command_line->HasSwitch(switches::kDisableGpuRasterization)) {
     command_line->AppendSwitch(switches::kEnableGpuRasterization);
+    
+    // Enable zero-copy rasterization for better performance
+    command_line->AppendSwitch(switches::kEnableZeroCopy);
+    
+    // Disable low-res tiling for smoother scrolling (at cost of more GPU usage)
+    command_line->AppendSwitch(switches::kDisableLowResTiling);
   }
 }

--- a/cc/base/switches.cc
+++ b/cc/base/switches.cc
@@ -XXX,6 +XXX,9 @@ const char kNumRasterThreads[] = "num-raster-threads";
+// Plutonium: Default to 4 raster threads for better scrolling performance
+// This parallelizes tile rasterization for smoother scrolling
+const char kDefaultNumRasterThreads[] = "4";

