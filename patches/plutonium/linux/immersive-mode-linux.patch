--- /dev/null
+++ b/chrome/browser/ui/views/frame/immersive_mode_controller_linux.cc
@@ -0,0 +1,952 @@
+// Copyright 2025 The Chromium Authors and Plutonium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/frame/immersive_mode_controller_linux.h"
+
+#include <algorithm>
+#include <set>
+#include <vector>
+
+#include "chrome/browser/ui/layout_constants.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/frame/top_container_view.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "ui/aura/env.h"
+#include "ui/aura/window.h"
+#include "ui/compositor/layer.h"
+#include "ui/compositor/scoped_layer_animation_settings.h"
+#include "ui/events/event.h"
+#include "ui/display/screen.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/transform.h"
+#include "ui/views/controls/native/native_view_host.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+// The reveal lock implementation for Linux.
+class ImmersiveModeControllerLinux::RevealedLock : public ImmersiveRevealedLock {
+ public:
+  explicit RevealedLock(base::WeakPtr<ImmersiveModeControllerLinux> controller)
+      : controller_(controller) {}
+
+  ~RevealedLock() override {
+    if (controller_) {
+      controller_->LockDestroyed();
+    }
+  }
+
+ private:
+  base::WeakPtr<ImmersiveModeControllerLinux> controller_;
+};
+
+ImmersiveModeControllerLinux::ImmersiveModeControllerLinux(
+    BrowserWindowInterface* browser)
+    : ImmersiveModeController(browser), animation_(this) {
+  animation_.SetSlideDuration(kAnimationDuration);
+}
+
+ImmersiveModeControllerLinux::~ImmersiveModeControllerLinux() {
+  if (browser_view_ && browser_view_->GetWidget()) {
+    browser_view_->GetWidget()->RemoveObserver(this);
+    if (auto* focus_manager = browser_view_->GetFocusManager()) {
+      focus_manager->RemoveFocusChangeListener(this);
+    }
+  }
+  if (auto* env = aura::Env::GetInstance()) {
+    env->RemoveEventObserver(this);
+  }
+  mouse_check_timer_.Stop();
+  initial_layout_timer_.Stop();
+}
+
+void ImmersiveModeControllerLinux::Init(BrowserView* browser_view) {
+  browser_view_ = browser_view;
+}
+
+void ImmersiveModeControllerLinux::SetEnabled(bool enabled) {
+  if (enabled_ == enabled) {
+    return;
+  }
+
+  enabled_ = enabled;
+
+  if (enabled_) {
+    EnsureTopContainerZOrder();
+    // Start listening for events.
+    if (browser_view_ && browser_view_->GetWidget()) {
+      browser_view_->GetWidget()->AddObserver(this);
+      if (auto* focus_manager = browser_view_->GetFocusManager()) {
+        focus_manager->AddFocusChangeListener(this);
+      }
+    }
+
+    if (auto* env = aura::Env::GetInstance()) {
+      env->AddEventObserver(this, env, std::set<ui::EventType>{
+          ui::EventType::kMouseMoved,
+          ui::EventType::kMouseEntered,
+          ui::EventType::kMouseExited});
+    }
+
+    ResetSlideLayers();
+    animation_.Stop();
+
+    // Start hidden by default.
+    visible_fraction_ = 0.0;
+    animation_state_ = AnimationState::kClosed;
+    animation_.Reset(0.0);
+    LayoutBrowserRootView();
+    ApplyTransform();
+  } else {
+    if (browser_view_ && browser_view_->GetWidget()) {
+      browser_view_->GetWidget()->RemoveObserver(this);
+      if (auto* focus_manager = browser_view_->GetFocusManager()) {
+        focus_manager->RemoveFocusChangeListener(this);
+      }
+    }
+
+    if (auto* env = aura::Env::GetInstance()) {
+      env->RemoveEventObserver(this);
+    }
+
+    mouse_check_timer_.Stop();
+    initial_layout_timer_.Stop();
+    animation_.Stop();
+    ResetSlideLayers();
+    ResetTopContainerZOrder();
+
+    visible_fraction_ = 1.0;
+    animation_state_ = AnimationState::kRevealed;
+    LayoutBrowserRootView();
+  }
+}
+
+bool ImmersiveModeControllerLinux::IsEnabled() const {
+  return enabled_;
+}
+
+bool ImmersiveModeControllerLinux::ShouldHideTopViews() const {
+  // Keep top UI rendered; we slide it out of view with transforms.
+  return false;
+}
+
+bool ImmersiveModeControllerLinux::IsRevealed() const {
+  bool revealed = !enabled_ || 
+                  animation_state_ == AnimationState::kRevealed ||
+                  animation_state_ == AnimationState::kSlideOpen ||
+                  animation_state_ == AnimationState::kSlideClose;
+  return revealed;
+}
+
+int ImmersiveModeControllerLinux::GetTopContainerVerticalOffset(
+    const gfx::Size& top_container_size) const {
+  // We use transforms now, so always return 0 for layout purposes
+  return 0;
