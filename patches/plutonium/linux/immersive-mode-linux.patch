diff --git a/chrome/browser/ui/views/frame/immersive_mode_controller_linux.h b/chrome/browser/ui/views/frame/immersive_mode_controller_linux.h
new file mode 100644
index 0000000000..2e9fc4a866
--- /dev/null
+++ b/chrome/browser/ui/views/frame/immersive_mode_controller_linux.h
@@ -0,0 +1,204 @@
+// Copyright 2025 The Chromium Authors and Plutonium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_IMMERSIVE_MODE_CONTROLLER_LINUX_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_IMMERSIVE_MODE_CONTROLLER_LINUX_H_
+
+#include <memory>
+#include <optional>
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/ui/views/frame/immersive_mode_controller.h"
+#include "ui/events/event_observer.h"
+#include "ui/gfx/animation/animation_delegate.h"
+#include "ui/gfx/animation/slide_animation.h"
+#include "ui/gfx/geometry/point.h"
+#include "ui/views/focus/focus_manager.h"
+#include "ui/views/widget/widget_observer.h"
+
+class BrowserView;
+
+// Linux implementation of ImmersiveModeController.
+// This controller auto-hides the top toolbar and reveals it when the user
+// moves the mouse to the top edge of the screen.
+class ImmersiveModeControllerLinux
+    : public ImmersiveModeController,
+      public gfx::AnimationDelegate,
+      public ui::EventObserver,
+      public views::FocusChangeListener,
+      public views::WidgetObserver {
+ public:
+  explicit ImmersiveModeControllerLinux(BrowserWindowInterface* browser);
+  ~ImmersiveModeControllerLinux() override;
+
+  ImmersiveModeControllerLinux(const ImmersiveModeControllerLinux&) = delete;
+  ImmersiveModeControllerLinux& operator=(const ImmersiveModeControllerLinux&) =
+      delete;
+
+  // ImmersiveModeController:
+  void Init(BrowserView* browser_view) override;
+  void SetEnabled(bool enabled) override;
+  bool IsEnabled() const override;
+  bool ShouldHideTopViews() const override;
+  bool IsRevealed() const override;
+  int GetTopContainerVerticalOffset(
+      const gfx::Size& top_container_size) const override;
+  std::unique_ptr<ImmersiveRevealedLock> GetRevealedLock(
+      AnimateReveal animate_reveal) override;
+  void OnFindBarVisibleBoundsChanged(
+      const gfx::Rect& new_visible_bounds_in_screen) override;
+  bool ShouldStayImmersiveAfterExitingFullscreen() override;
+  int GetMinimumContentOffset() const override;
+  int GetExtraInfobarOffset() const override;
+  void OnContentFullscreenChanged(bool is_content_fullscreen) override;
+
+ private:
+  class RevealedLock;
+  friend class RevealedLock;
+
+  // Animation states for the toolbar.
+  enum class AnimationState {
+    kClosed,       // Toolbar is hidden
+    kSlideOpen,    // Toolbar is animating to revealed
+    kRevealed,     // Toolbar is fully visible
+    kSlideClose,   // Toolbar is animating to hidden
+  };
+
+  // gfx::AnimationDelegate:
+  void AnimationEnded(const gfx::Animation* animation) override;
+  void AnimationProgressed(const gfx::Animation* animation) override;
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override;
+
+  // views::FocusChangeListener:
+  void OnWillChangeFocus(views::View* focused_before,
+                         views::View* focused_now) override;
+  void OnDidChangeFocus(views::View* focused_before,
+                        views::View* focused_now) override;
+
+  // views::WidgetObserver:
+  void OnWidgetDestroying(views::Widget* widget) override;
+  void OnWidgetBoundsChanged(views::Widget* widget,
+                             const gfx::Rect& new_bounds) override;
+
+  // Called when the mouse position should be checked for reveal.
+  void OnMouseCheckTimer();
+
+  // Called to do initial layout update
+  void OnInitialLayoutTimer();
+
+  // Updates the revealed state based on mouse position and locks.
+  void UpdateRevealedState(bool animate);
+
+  // Starts or stops revealing the toolbar.
+  void StartReveal(bool animate);
+  void StartClose(bool animate);
+
+  // Called when a reveal lock is destroyed.
+  void LockDestroyed();
+
+  // Ensures the root view is ready for sliding (expanded + layer-backed).
+  void EnsureSlideLayers();
+
+  // Ensures the top container is stacked above web contents.
+  void EnsureTopContainerZOrder();
+
+  // Restores the original top container stacking.
+  void ResetTopContainerZOrder();
+
+  // Restores the root view after sliding.
+  void ResetSlideLayers();
+
+  // Updates the root view bounds for the current top container height.
+  void UpdateRootViewBoundsForSlide(int top_container_height);
+
+  // Returns the current top container height for sliding.
+  int GetTopContainerHeight() const;
+
+  // Forces a layout/paint update after reveal state changes.
+  void LayoutBrowserRootView();
+
+  // Updates the top container offset based on animation progress.
+  void UpdateTopContainerOffset();
+
+  // Applies transform to slide the browser root view.
+  void ApplyTransform();
+
+  // Returns true if the mouse is near the top edge of the screen.
+  bool IsMouseNearTopEdge() const;
+
+  // Returns true if the mouse is over a given view in screen coordinates.
+  bool IsMouseOverView(const views::View* view) const;
+
+  // Returns true if the mouse is over the top controls region.
+  bool IsMouseOverTopControls() const;
+
+  // Returns true if there are any active reveal locks.
+  bool HasRevealLocks() const { return reveal_lock_count_ > 0; }
+
+  // The browser view this controller is attached to.
+  raw_ptr<BrowserView> browser_view_ = nullptr;
+
+  // Whether immersive mode is enabled.
+  bool enabled_ = false;
+
+  // The current animation state.
+  AnimationState animation_state_ = AnimationState::kClosed;
+
+  // Animation for sliding the toolbar in/out.
+  gfx::SlideAnimation animation_;
+
+  // The fraction of the toolbar that is visible (0.0 = hidden, 1.0 = visible).
+  double visible_fraction_ = 0.0;
+
+  // True when root view layers/bounds are configured for sliding.
+  bool slide_layers_installed_ = false;
+
+  // Cached top container height for slide bounds calculations.
+  int slide_top_container_height_ = 0;
+
+  // Original index of top container within main_container.
+  std::optional<size_t> top_container_original_index_;
+
+  // Track whether we forced a layer on top_container for visibility.
+  bool forced_top_container_layer_ = false;
+
+  // Timer for periodically checking mouse position.
+  base::RepeatingTimer mouse_check_timer_;
+
+  // Number of active reveal locks.
+  int reveal_lock_count_ = 0;
+
+  // Last known mouse position.
+  gfx::Point last_mouse_position_;

+  // Timer for initial layout update
+  base::OneShotTimer initial_layout_timer_;
+
+  // Height of the top edge region that triggers reveal.
+  static constexpr int kTopEdgeThresholdDip = 3;
+
+  // Delay before revealing the toolbar when mouse is at top edge.
+  static constexpr base::TimeDelta kRevealDelay = base::Milliseconds(200);
+
+  // Duration of the slide animation.
+  static constexpr base::TimeDelta kAnimationDuration = base::Milliseconds(200);
+
+  base::WeakPtrFactory<ImmersiveModeControllerLinux> weak_ptr_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_IMMERSIVE_MODE_CONTROLLER_LINUX_H_
