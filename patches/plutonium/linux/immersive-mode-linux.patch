+
+void ImmersiveModeControllerLinux::AnimationEnded(
+    const gfx::Animation* animation) {
+  if (animation_state_ == AnimationState::kSlideOpen) {
+    animation_state_ = AnimationState::kRevealed;
+    LayoutBrowserRootView();
+    ApplyTransform();
+    for (auto& observer : observers_) {
+      observer.OnImmersiveRevealEnded();
+    }
+  } else if (animation_state_ == AnimationState::kSlideClose) {
+    animation_state_ = AnimationState::kClosed;
+    LayoutBrowserRootView();
+    ApplyTransform();
+  }
+}
+
+void ImmersiveModeControllerLinux::AnimationProgressed(
+    const gfx::Animation* animation) {
+  visible_fraction_ = animation_.GetCurrentValue();
+  ApplyTransform();
+}
+
+void ImmersiveModeControllerLinux::OnEvent(const ui::Event& event) {
+  if (!enabled_) {
+    return;
+  }
+
+  if (event.IsMouseEvent()) {
+    if (display::Screen* screen = display::Screen::Get()) {
+      last_mouse_position_ = screen->GetCursorScreenPoint();
+    } else {
+      last_mouse_position_ = event.AsMouseEvent()->root_location();
+    }
+
+    const bool over_top_controls = IsMouseOverTopControls();
+    if (over_top_controls) {
+      if (!mouse_check_timer_.IsRunning() &&
+          animation_state_ == AnimationState::kClosed) {
+        mouse_check_timer_.Start(FROM_HERE, kRevealDelay,
+            base::BindRepeating(
+                &ImmersiveModeControllerLinux::OnMouseCheckTimer,
+                weak_ptr_factory_.GetWeakPtr()));
+      }
+    } else {
+      mouse_check_timer_.Stop();
+      if (!HasRevealLocks() && animation_state_ == AnimationState::kRevealed) {
+        StartClose(true);
+      }
+    }
+  }
+}
+
+void ImmersiveModeControllerLinux::OnWillChangeFocus(views::View* focused_before,
+                                                      views::View* focused_now) {
+}
+
+void ImmersiveModeControllerLinux::OnDidChangeFocus(views::View* focused_before,
+                                                     views::View* focused_now) {
+  if (!enabled_) {
+    return;
+  }
+
+  if (focused_now && browser_view_) {
+    views::View* top_container = browser_view_->top_container();
+    if (top_container && top_container->Contains(focused_now)) {
+      if (animation_state_ != AnimationState::kRevealed) {
+        StartReveal(true);
+      }
+    }
+  }
+}
+
+void ImmersiveModeControllerLinux::OnWidgetDestroying(views::Widget* widget) {
+  SetEnabled(false);
+}
+
+void ImmersiveModeControllerLinux::OnWidgetBoundsChanged(
+    views::Widget* widget,
+    const gfx::Rect& new_bounds) {
+  if (!slide_layers_installed_) {
+    return;
+  }
+
+  ApplyTransform();
+}
+
+void ImmersiveModeControllerLinux::OnMouseCheckTimer() {
+  if (display::Screen* screen = display::Screen::Get()) {
+    last_mouse_position_ = screen->GetCursorScreenPoint();
+  }
+  if (IsMouseOverTopControls() && animation_state_ == AnimationState::kClosed) {
+    StartReveal(true);
+  }
+  mouse_check_timer_.Stop();
+}
+
+void ImmersiveModeControllerLinux::OnInitialLayoutTimer() {
+  LayoutBrowserRootView();
+  ApplyTransform();
+}
+
+void ImmersiveModeControllerLinux::UpdateRevealedState(bool animate) {
+  if (HasRevealLocks() || IsMouseOverTopControls()) {
+    StartReveal(animate);
+  } else {
+    StartClose(animate);
+  }
+}
+
+void ImmersiveModeControllerLinux::StartReveal(bool animate) {
+  if (animation_state_ == AnimationState::kRevealed ||
+      animation_state_ == AnimationState::kSlideOpen) {
+    return;
+  }
+
+  animation_state_ = AnimationState::kSlideOpen;
+  LayoutBrowserRootView();
+
+  for (auto& observer : observers_) {
+    observer.OnImmersiveRevealStarted();
+  }
+
+  if (animate) {
+    EnsureSlideLayers();
+    animation_.Reset(visible_fraction_);
+    animation_.Show();
+  } else {
+    animation_.Reset(1.0);
+    visible_fraction_ = 1.0;
+    animation_state_ = AnimationState::kRevealed;
+    EnsureSlideLayers();
+    LayoutBrowserRootView();
+    ApplyTransform();
+  }
+}
+
+void ImmersiveModeControllerLinux::StartClose(bool animate) {
+  if (animation_state_ == AnimationState::kClosed ||
+      animation_state_ == AnimationState::kSlideClose) {
+    return;
+  }
+
+  if (HasRevealLocks()) {
+    return;
+  }
+
+  animation_state_ = AnimationState::kSlideClose;
+
+  if (animate) {
+    EnsureSlideLayers();
+    animation_.Reset(visible_fraction_);
+    animation_.Hide();
+  } else {
+    animation_.Reset(0.0);
+    visible_fraction_ = 0.0;
+    animation_state_ = AnimationState::kClosed;
+    EnsureSlideLayers();
+    ApplyTransform();
+  }
+}
+
+void ImmersiveModeControllerLinux::LockDestroyed() {
+  --reveal_lock_count_;
+  if (reveal_lock_count_ == 0 && enabled_) {
+    if (!IsMouseOverTopControls()) {
+      StartClose(true);
+    }
+  }
+}
+
+void ImmersiveModeControllerLinux::EnsureSlideLayers() {
+  if (slide_layers_installed_) {
+    return;
+  }
+
+  if (!browser_view_ || !browser_view_->GetWidget() ||
+      browser_view_->GetWidget()->IsClosed()) {
+    return;
+  }
+
+  const int top_container_height = GetTopContainerHeight();
+  if (top_container_height <= 0) {
+    return;
+  }
+
+  // Ensure top_container paints to its own layer so it can slide.
+  // After reparenting, tab_strip is inside top_container so we only need
+  // to transform top_container.
+  if (views::View* top_container = browser_view_->top_container()) {
+    if (!top_container->layer()) {
+      top_container->SetPaintToLayer();
+      forced_top_container_layer_ = true;
+    }
+    top_container->layer()->SetFillsBoundsOpaquely(false);
+  }
+
+  EnsureTopContainerZOrder();
+
+  if (auto* widget = browser_view_->GetWidget()) {
+    widget->ReorderNativeViews();
+  }
+
+  slide_layers_installed_ = true;
+}
+
+void ImmersiveModeControllerLinux::ResetSlideLayers() {
+  if (!slide_layers_installed_) {
+    if (browser_view_ && forced_top_container_layer_) {
+      if (auto* top_container = browser_view_->top_container()) {
+        if (top_container->layer()) {
+          top_container->DestroyLayer();
+        }
+      }
+      forced_top_container_layer_ = false;
+    }
+    return;
+  }
+
+  if (!browser_view_ || !browser_view_->GetWidget()) {
+    slide_layers_installed_ = false;
+    slide_top_container_height_ = 0;
+    return;
+  }
+
+  views::Widget* widget = browser_view_->GetWidget();
+
+  const gfx::Transform identity;
+  if (auto* top_container = browser_view_->top_container()) {
+    if (top_container->layer()) {
+      ui::ScopedLayerAnimationSettings settings(top_container->layer()->GetAnimator());
+      settings.SetTransitionDuration(base::Milliseconds(0));
+      settings.SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_SET_NEW_TARGET);
+      top_container->layer()->SetTransform(identity);
+    }
+  }
+
+  if (forced_top_container_layer_) {
+    if (auto* top_container = browser_view_->top_container()) {
+      if (top_container->layer()) {
+        top_container->DestroyLayer();
+      }
+    }
+    forced_top_container_layer_ = false;
+  }
+  slide_layers_installed_ = false;
+  slide_top_container_height_ = 0;
+
+}
+
+void ImmersiveModeControllerLinux::EnsureTopContainerZOrder() {
+  if (!browser_view_) {
+    return;
+  }
+
+  views::View* main_container = browser_view_->main_container();
+  views::View* top_container = browser_view_->top_container();
+  if (!main_container || !top_container ||
+      top_container->parent() != main_container) {
+    return;
+  }
+
+  const std::optional<size_t> current_index =
+      main_container->GetIndexOf(top_container);
+  if (!current_index) {
+    return;
+  }
+  if (!top_container_original_index_) {
+    top_container_original_index_ = *current_index;
+  }
+
+  const size_t target_index = main_container->children().size() - 1;
+  if (*current_index != target_index) {
+    main_container->ReorderChildView(top_container, target_index);
+    if (auto* widget = browser_view_->GetWidget()) {
+      widget->ReorderNativeViews();
+    }
+  }
+}
+
+void ImmersiveModeControllerLinux::ResetTopContainerZOrder() {
+  if (!browser_view_ || !top_container_original_index_) {
+    return;
+  }
+
+  views::View* main_container = browser_view_->main_container();
+  views::View* top_container = browser_view_->top_container();
+  if (!main_container || !top_container ||
+      top_container->parent() != main_container) {
+    top_container_original_index_.reset();
+    return;
+  }
+
+  const size_t target_index = *top_container_original_index_;
+  if (target_index < main_container->children().size()) {
+    main_container->ReorderChildView(top_container, target_index);
+    if (auto* widget = browser_view_->GetWidget()) {
+      widget->ReorderNativeViews();
+    }
+  }
+  top_container_original_index_.reset();
+}
+
+void ImmersiveModeControllerLinux::UpdateRootViewBoundsForSlide(
+    int top_container_height) {
+  if (!browser_view_ || !browser_view_->GetWidget()) {
+    return;
+  }
+
+  views::Widget* widget = browser_view_->GetWidget();
+  views::View* root_view = widget->GetRootView();
+  ui::Layer* widget_layer = widget->GetLayer();
+  if (!root_view || !widget_layer || top_container_height <= 0) {
+    return;
+  }
+
+  gfx::Rect root_bounds = root_view->bounds();
+  const int new_height =
+      widget_layer->bounds().height() + top_container_height;
+  if (root_bounds.height() != new_height) {
+    root_bounds.set_height(new_height);
+    root_view->SetBoundsRect(root_bounds);
+    widget->LayoutRootViewIfNecessary();
+  }
+  slide_top_container_height_ = top_container_height;
+}
+
+int ImmersiveModeControllerLinux::GetTopContainerHeight() const {
+  if (!browser_view_) {
+    return 0;
+  }
+
+  views::View* top_container = browser_view_->top_container();
+  if (!top_container) {
+    return 0;
+  }
+
+  const views::View* tab_strip = browser_view_->tab_strip_view();
+  const bool include_tab_strip = browser_view_->ShouldDrawTabStrip() &&
+                                 tab_strip && tab_strip->parent() != top_container;
+
+  int max_bottom = 0;
+  auto update_bottom = [&](const views::View* view) {
+    if (!view) {
+      return;
+    }
+    const gfx::Rect bounds = views::View::ConvertRectToTarget(
+        view, browser_view_, view->GetLocalBounds());
+    if (bounds.bottom() > max_bottom) {
+      max_bottom = bounds.bottom();
+    }
+  };
+
+  update_bottom(top_container);
+  if (include_tab_strip) {
+    update_bottom(tab_strip);
+  }
+
+  int preferred_height = top_container->GetPreferredSize().height();
+  if (include_tab_strip && tab_strip) {
+    const int tab_strip_height = tab_strip->GetPreferredSize().height();
+    if (tab_strip_height > 0) {
+      preferred_height += tab_strip_height -
+                          GetLayoutConstant(TABSTRIP_TOOLBAR_OVERLAP);
+    }
+  }
+
+  if (preferred_height > 0) {
+    return max_bottom > 0 ? std::max(max_bottom, preferred_height)
+                          : preferred_height;
+  }
+
+  return max_bottom;
+}
+
+void ImmersiveModeControllerLinux::LayoutBrowserRootView() {
+  if (!browser_view_ || !browser_view_->GetWidget() ||
+      browser_view_->GetWidget()->IsClosed()) {
+    return;
+  }
+
+  browser_view_->top_container()->OnImmersiveRevealUpdated();
+  browser_view_->DeprecatedLayoutImmediately();
+  browser_view_->contents_container()->InvalidateLayout();
+}
+
+void ImmersiveModeControllerLinux::UpdateTopContainerOffset() {
+  ApplyTransform();
+}
+
+void ImmersiveModeControllerLinux::ApplyTransform() {
+  if (!browser_view_ || !browser_view_->GetWidget() ||
+      browser_view_->GetWidget()->IsClosed()) {
+    return;
+  }
+
+  const int top_container_height = GetTopContainerHeight();
+  if (top_container_height <= 0) {
+    if (!initial_layout_timer_.IsRunning()) {
+      initial_layout_timer_.Start(
+          FROM_HERE, base::Milliseconds(50),
+          base::BindOnce(&ImmersiveModeControllerLinux::OnInitialLayoutTimer,
+                         weak_ptr_factory_.GetWeakPtr()));
+    }
+    return;
+  }
+
+  EnsureSlideLayers();
+  if (!slide_layers_installed_) {
+    return;
+  }
+
+  const float y_translation =
+      top_container_height * (visible_fraction_ - 1.0);
+
+  gfx::Transform transform;
+  transform.Translate(0, y_translation);
+
+  // Only transform top_container - after reparenting, tab_strip is inside it
+  if (auto* top_container = browser_view_->top_container()) {
+    if (top_container->layer()) {
+      ui::ScopedLayerAnimationSettings settings(top_container->layer()->GetAnimator());
+      settings.SetTransitionDuration(base::Milliseconds(0));
+      settings.SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_SET_NEW_TARGET);
+      top_container->layer()->SetTransform(transform);
+    }
+  }
+}
+
+bool ImmersiveModeControllerLinux::IsMouseNearTopEdge() const {
+  if (!browser_view_ || !browser_view_->GetWidget()) {
+    return false;
+  }
+
+  views::Widget* widget = browser_view_->GetWidget();
+  gfx::Rect widget_bounds = widget->GetWindowBoundsInScreen();
+
+  bool near_top = last_mouse_position_.y() >= widget_bounds.y() &&
+                  last_mouse_position_.y() <= widget_bounds.y() + kTopEdgeThresholdDip &&
+                  last_mouse_position_.x() >= widget_bounds.x() &&
+                  last_mouse_position_.x() <= widget_bounds.right();
+  
+  return near_top;
+}
+
+bool ImmersiveModeControllerLinux::IsMouseOverView(
+    const views::View* view) const {
+  if (!browser_view_ || !view || !view->GetVisible()) {
+    return false;
+  }
+  return view->GetBoundsInScreen().Contains(last_mouse_position_);
+}
+
+bool ImmersiveModeControllerLinux::IsMouseOverTopControls() const {
+  if (!browser_view_) {
+    return false;
+  }
+  if (IsMouseNearTopEdge()) {
+    return true;
+  }
+  if (IsMouseOverView(browser_view_->top_container())) {
+    return true;
+  }
+  if (browser_view_->ShouldDrawTabStrip() &&
+      IsMouseOverView(browser_view_->tab_strip_view())) {
+    return true;
+  }
+  return false;
+}

