# Consolidated Plutonium optimizations (Chromium 143.0.7499.146)
#
# This patch combines several performance-focused optimizations:
# 1. SIMD instruction set support (SSE3, SSE4.1, SSE4.2, AVX, AVX2)
# 2. Aggressive LLVM optimizations (-aggressive-ext-opt, -enable-gvn-hoist)
# 3. Maximum optimization levels (-O3) for official builds
# 4. Enhanced ThinLTO inlining (import_instr_limit=100)
#
# Inspired by Thorium and Helium.

diff --git a/build/config/BUILDCONFIG.gn b/build/config/BUILDCONFIG.gn
index 69f7eb1ac4..259c589ffb 100644
--- a/build/config/BUILDCONFIG.gn
+++ b/build/config/BUILDCONFIG.gn
@@ -353,6 +353,7 @@ default_compiler_configs = [
   "//build/config/compiler:compiler",
   "//build/config/compiler:compiler_arm_fpu",
   "//build/config/compiler:compiler_arm_thumb",
+  "//build/config/compiler:plutonium_lto_optimizations",
   "//build/config/compiler:default_include_dirs",
   "//build/config/compiler:default_init_stack_vars",
   "//build/config/compiler:default_optimization",
diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index 7f709b518a..26c89f02cc 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -49,6 +49,11 @@ if (!is_clang) {
 declare_args() {
   # This allows overriding the location of lld.
   lld_path = default_lld_path
+  use_sse3 = true
+  use_sse41 = true
+  use_sse42 = true
+  use_avx = false
+  use_avx2 = false
 }
 
 declare_args() {
@@ -319,6 +324,14 @@ config("no_unresolved_symbols") {
 config("compiler") {
   asmflags = []
   cflags = []
+  if (is_official_build && !is_debug && is_clang) {
+    cflags += [
+      "-mllvm",
+      "-aggressive-ext-opt",
+      "-mllvm",
+      "-enable-gvn-hoist",
+    ]
+  }
   cflags_c = []
   cflags_cc = []
   cflags_objc = []
@@ -2823,7 +2836,7 @@ config("optimize") {
     # vectorization while otherwise optimizing for size.
     rustflags = [ "-Copt-level=s" ]
   } else {
-    cflags = [ "-O2" ] + common_optimize_on_cflags
+    cflags = [ "-O3" ] + common_optimize_on_cflags
 
     # The `-O3` for clang turns on extra optimizations compared to the standard
     # `-O2`. But for rust, `-Copt-level=3` is the default and is thus reliable
@@ -2878,7 +2891,7 @@ config("optimize_max") {
   } else if (optimize_for_fuzzing) {
     cflags = [ "-O1" ] + common_optimize_on_cflags
   } else {
-    cflags = [ "-O2" ] + common_optimize_on_cflags
+    cflags = [ "-O3" ] + common_optimize_on_cflags
   }
   rustflags = [ "-Copt-level=3" ]
 }
@@ -3399,3 +3412,30 @@ config("cet_shadow_stack") {
     ldflags = [ "/CETCOMPAT" ]
   }
 }
+
+# Plutonium: Additional linker optimizations for ThinLTO
+config("plutonium_lto_optimizations") {
+  if (use_thin_lto && is_official_build && !is_debug) {
+    if (is_win) {
+      ldflags = [
+        "-mllvm:-import-instr-limit=100",
+        "-mllvm:-aggressive-ext-opt",
+        "-mllvm:-enable-gvn-hoist",
+      ]
+    } else {
+      ldflags = [
+        "-Wl,-mllvm,-import-instr-limit=100",
+        "-Wl,-mllvm,-aggressive-ext-opt",
+        "-Wl,-mllvm,-enable-gvn-hoist",
+        "-Wl,-O3",
+      ]
+      # Architecture-specific tuning for AVX2 builds
+      if (defined(use_avx2) && use_avx2) {
+        ldflags += [
+          "-Wl,-mllvm,-march=haswell",
+          "-Wl,-mllvm,-fp-contract=fast",
+        ]
+      }
+    }
+  }
+}
